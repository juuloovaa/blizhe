generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserMode {
  solo
  couple
}

enum CoupleStatus {
  active
  dissolved
}

enum MemberRole {
  inviter
  invitee
}

enum InviteStatus {
  pending
  accepted
  cancelled
  expired
}

enum DailyQuestionType {
  solo
  couple
}

enum MoodType {
  need_support
  want_talk
  want_close
  tired
  anxious
  grateful
  feeling_good
}

enum CardCategory {
  closeness
  reflection
  romance
  intimate
}

enum TestType {
  personal
  couple
  game
}

enum SessionStatus {
  in_progress
  waiting_partner
  completed
  cancelled
}

enum ParticipantStatus {
  pending
  in_progress
  done
}

enum AssistantRole {
  user
  assistant
  system
}

model User {
  id                  String   @id @default(uuid())
  telegramId          BigInt   @unique @map("telegram_id")
  username            String?
  firstName           String?  @map("first_name")
  lastName            String?  @map("last_name")
  photoUrl            String?  @map("photo_url")
  displayName         String   @map("display_name")
  pronouns            String?
  mode                UserMode @default(solo)
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  memberships         CoupleMember[]
  invitesSent         CoupleInvite[] @relation("InviterInvites")
  blocksCreated       Block[]        @relation("Blocker")
  blocksReceived      Block[]        @relation("Blocked")
  notificationSettings NotificationSettings?
  dailyAnswers        DailyAnswer[]
  moodNotes           MoodNote[]
  favoriteCards       FavoriteCard[]
  cardsSharedFrom     CardShare[]    @relation("CardFrom")
  cardsSharedTo       CardShare[]    @relation("CardTo")
  testSessionsInitiated TestSession[] @relation("SessionInitiator")
  testParticipations  TestParticipant[]
  testAnswers         TestAnswer[]
  assistantMessages   AssistantMessage[]

  @@map("users")
}

model Couple {
  id          String       @id @default(uuid())
  status      CoupleStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at")
  dissolvedAt DateTime?    @map("dissolved_at")

  members     CoupleMember[]
  invites     CoupleInvite[]
  dailyAnswers DailyAnswer[]
  moodNotes   MoodNote[]
  cardShares  CardShare[]
  testSessions TestSession[]

  @@map("couples")
}

model CoupleMember {
  id       String     @id @default(uuid())
  coupleId String     @map("couple_id")
  userId   String     @map("user_id")
  role     MemberRole
  joinedAt DateTime   @default(now()) @map("joined_at")
  leftAt   DateTime?  @map("left_at")

  couple Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([coupleId])
  @@index([userId])
  @@map("couple_members")
}

model CoupleInvite {
  id        String       @id @default(uuid())
  code      String       @unique
  inviterId String       @map("inviter_id")
  coupleId  String?      @map("couple_id")
  status    InviteStatus @default(pending)
  createdAt DateTime     @default(now()) @map("created_at")
  expiresAt DateTime     @map("expires_at")

  inviter User    @relation("InviterInvites", fields: [inviterId], references: [id], onDelete: Cascade)
  couple  Couple? @relation(fields: [coupleId], references: [id], onDelete: SetNull)

  @@index([inviterId, status])
  @@map("couple_invites")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

model NotificationSettings {
  userId          String  @id @map("user_id")
  moodNotes       Boolean @default(true) @map("mood_notes")
  testInvites     Boolean @default(true) @map("test_invites")
  testPartnerDone Boolean @default(true) @map("test_partner_done")
  dailyQuestion   Boolean @default(true) @map("daily_question")
  partnerCard     Boolean @default(true) @map("partner_card")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model DailyQuestion {
  id     String            @id @default(uuid())
  text   String
  type   DailyQuestionType
  active Boolean           @default(true)

  answers DailyAnswer[]

  @@map("daily_questions")
}

model DailyAnswer {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  userId     String   @map("user_id")
  coupleId   String?  @map("couple_id")
  answerText String   @map("answer_text")
  answerDate DateTime @db.Date @map("answer_date")
  createdAt  DateTime @default(now()) @map("created_at")

  question DailyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  couple   Couple?       @relation(fields: [coupleId], references: [id], onDelete: SetNull)

  @@unique([questionId, userId, answerDate])
  @@index([userId, answerDate])
  @@map("daily_answers")
}

model MoodNote {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  coupleId  String   @map("couple_id")
  mood      MoodType
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  couple Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId, createdAt])
  @@map("mood_notes")
}

model Card {
  id       String       @id @default(uuid())
  category CardCategory
  text     String
  isAdult  Boolean      @default(false) @map("is_adult")
  active   Boolean      @default(true)

  favorites FavoriteCard[]
  shares    CardShare[]

  @@map("cards")
}

model FavoriteCard {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  cardId    String   @map("card_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@map("favorite_cards")
}

model CardShare {
  id         String    @id @default(uuid())
  cardId     String    @map("card_id")
  fromUserId String    @map("from_user_id")
  toUserId   String    @map("to_user_id")
  coupleId   String    @map("couple_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  readAt     DateTime? @map("read_at")

  card     Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fromUser User   @relation("CardFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User   @relation("CardTo", fields: [toUserId], references: [id], onDelete: Cascade)
  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@map("card_shares")
}

model Test {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  type        TestType
  topic       String
  active      Boolean  @default(true)

  questions TestQuestion[]
  sessions  TestSession[]

  @@map("tests")
}

model TestQuestion {
  id      String @id @default(uuid())
  testId  String @map("test_id")
  order   Int
  text    String
  options Json

  test    Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers TestAnswer[]

  @@index([testId, order])
  @@map("test_questions")
}

model TestSession {
  id          String        @id @default(uuid())
  testId      String        @map("test_id")
  coupleId    String?       @map("couple_id")
  initiatorId String        @map("initiator_id")
  status      SessionStatus @default(in_progress)
  resultJson  Json?         @map("result_json")
  createdAt   DateTime      @default(now()) @map("created_at")
  completedAt DateTime?     @map("completed_at")

  test         Test              @relation(fields: [testId], references: [id], onDelete: Cascade)
  couple       Couple?           @relation(fields: [coupleId], references: [id], onDelete: SetNull)
  initiator    User              @relation("SessionInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  participants TestParticipant[]
  answers      TestAnswer[]

  @@index([coupleId, status])
  @@map("test_sessions")
}

model TestParticipant {
  id          String            @id @default(uuid())
  sessionId   String            @map("session_id")
  userId      String            @map("user_id")
  status      ParticipantStatus @default(pending)
  completedAt DateTime?         @map("completed_at")

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("test_participants")
}

model TestAnswer {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  userId     String   @map("user_id")
  questionId String   @map("question_id")
  optionId   String   @map("option_id")
  createdAt  DateTime @default(now()) @map("created_at")

  session  TestSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, questionId])
  @@map("test_answers")
}

model AssistantMessage {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  role       AssistantRole
  content    String
  safetyFlag Boolean       @default(false) @map("safety_flag")
  createdAt  DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("assistant_messages")
}
