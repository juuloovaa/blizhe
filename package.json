{
  "name": "blizhe",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate --workspace=@blizhe/api",
    "dev": "npm run dev --workspace=@blizhe/api & npm run dev --workspace=@blizhe/web",
    "dev:api": "npm run dev --workspace=@blizhe/api",
    "dev:web": "npm run dev --workspace=@blizhe/web",
    "build": "npm run build --workspace=@blizhe/api && npm run build --workspace=@blizhe/web",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run prisma:migrate --workspace=@blizhe/api",
    "db:seed": "npm run prisma:seed --workspace=@blizhe/api"
  }
}
